# Copy these into Vercel: Project > Settings > Environment Variables.
# The real values live in .env (not committed).

# Long random string used to sign login sessions (64+ characters).
SESSION_SECRET=

# Owner logins. Passwords are stored as scrypt hashes, never as plain text.
# Format: [{"u":"Username","h":"scrypt$..."}]
OWNER_ACCOUNTS=

# Added for you by Vercel when you connect a Neon Postgres database.
DATABASE_URL=
